    }
    source_format     = "NEWLINE_DELIMITED_JSON"
    write_disposition = "WRITE_TRUNCATE"
    autodetect        = false
  }

  depends_on = [google_storage_bucket_object.fct_lead_time_ndjson]
}

resource "google_bigquery_job" "load_dim_focus_components" {
  count = local.load_curated_data ? 1 : 0

  project  = var.project_id
  job_id   = "load-dim-focus-${substr(filemd5(local.dim_focus_components_local_path), 0, 12)}"
