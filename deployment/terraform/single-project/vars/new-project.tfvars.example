# Copy to vars/my_env.tfvars in a separate clone for your Google Cloud project.
# my_env.tfvars is gitignored. Do not reuse another project's Terraform state.
# The project must already exist with billing enabled.
project_id   = "your-gcp-project-id"
project_name = "pma-agent"   # Matches the application's pma_agent_analytics dataset.
region       = "us-central1" # Check your organization's allowed regions.

# Fresh project: create the datastore and import the local PDF inventory.
# Keep global: the current IPC specialist builds a global datastore path.
knowledge_base_data_store_id     = "ipc-part-numbers"
knowledge_base_display_name      = "IPC part numbers"
knowledge_base_location          = "global"
create_knowledge_base_data_store = true
adopt_existing_data_store        = false
ingest_ipc_documents             = true

# Optional: use another authorized manual directory. Absolute path recommended.
# Keep the layout <AMOS type>/<ATA chapter>___<revision>.pdf.
# ipc_source_dir = "/absolute/path/to/ipc_part_numbers"

# Real-data mode
create_curated_tables          = true
load_curated_data              = false
run_curated_real_data_pipeline = true

# Real-data mode tuning (used only when run_curated_real_data_pipeline = true).
curated_sim_threshold      = 0.80
curated_k_precursors       = 50
curated_embedding_endpoint = "text-embedding-005"
curated_llm_endpoint       = "gemini-3.8-flash"
