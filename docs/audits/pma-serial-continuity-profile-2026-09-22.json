  "definitions": {
    "target_pn": "Exact punctuation-preserving trimmed uppercase PN.",
    "serial": "Exact punctuation-preserving trimmed uppercase serial; no fuzzy match.",
    "placeholder_serials": "Exclude blanks, explicit NA/N/A/NIL/NONE/NULL/UNKNOWN/UNK/NOT KNOWN/NOT APPLICABLE/TBD/no-serial labels, punctuation-only strings, and all-zero strings with optional SN/SERIAL prefix. This is a documented conservative lexical screen, not proof of manufacturer serial validity or anonymization stability.",
    "aircraft": "MSN where present, otherwise full registration; missing identity excluded.",
    "time": "Primary ordering uses timezone-aware WO closing timestamp, not inferred physical movement time. Closing TAC is an airframe observation at WO closure.",
    "strict_pair": "Target PN on side then same PN/serial off side, same aircraft, distinct WOs, strictly increasing closing timestamps AND closing TAC.",
    "consecutive_pair": "Strict pair whose on/off are adjacent unique timestamp groups in the observed same-aircraft PN/serial occurrence stream. Missing intermediate events remain unknowable.",
    "cross_aircraft_conflict": "Same PN/serial occurs on another known aircraft at any closing timestamp inside the inclusive candidate interval; excluded from conservative candidates.",
    "intermediate_history": "Any other WO on the same aircraft with closing timestamp AND TAC strictly inside the candidate interval; ATA-4 checked against removal WO. Mere occurrence is not symptom evidence.",
    "unflagged_subset": "Further excludes candidate intervals with an internal out-of-range aircraft counter or another target-PN movement at the same coarse position. Coarse positions can contain multiple units, so the latter is a conservative exclusion for an initial experiment, not proof of invalidity.",
    "limits": "Candidate installation-to-removal observations only. They do not prove component lifetime, continuous installation, failure, complete observation, symptom onset, or a prospective remaining-cycles model."
  },
