# What a deploy must not upload. Both `agents-cli deploy` and `gcloud` read this
# file in preference to .gitignore once it exists, so it includes .gitignore
# rather than restating it: a project keeps one list of build output and one
# list of things that are merely not worth uploading.
#!include:.gitignore

.git
.gitignore
.gcloudignore

# Extensions are vendored into the repository and committed, but the deployed
# agent never reads them: `agents-cli install` restores them from the pins in
# agents-cli-extensions.yaml, and their code runs on the developer's machine.
# Uploading them costs image size and ships their sources with the agent.
/extensions/

# Raw maintenance exports and catalogue PDFs are already served by BigQuery
# and the knowledge base; they are not inputs to the application image build.
/data/
/artifacts/

# The frontend is rebuilt inside the image (Dockerfile node stage); its local
# dependencies and build/test output are only ignored by frontend/.gitignore,
# which the root include above does not cover.
/frontend/node_modules/
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/

# Local tooling state: Claude Code worktrees and linter caches.
/.claude/
.ruff_cache/
.pytest_cache/
