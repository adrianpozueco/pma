{
  "name": "ryanair-maintenance-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:preview": "npm run build && node scripts/create-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:ui": "npm run build && node --test tests/ui.test.mjs",
    "test:unit": "node --test tests/api.test.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.2.53",
    "@types/react-dom": "18.2.18",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
